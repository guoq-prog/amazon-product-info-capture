{
  "manifest_version": 3,
  "name": "Amazon 商品信息采集器（本地版）",
  "version": "1.4.09",
  "version_name": "v1.4.09",
  "description": "在 Amazon 商品详情页采集商品信息、评分、图片和 Listing 内容并导出；数据仅保存在浏览器本地。",
  "permissions": ["storage", "tabs"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.de/*", "https://amazon.de/*",
        "https://www.amazon.com/*", "https://amazon.com/*",
        "https://www.amazon.co.uk/*", "https://amazon.co.uk/*",
        "https://www.amazon.fr/*", "https://amazon.fr/*",
        "https://www.amazon.it/*", "https://amazon.it/*",
        "https://www.amazon.es/*", "https://amazon.es/*",
        "https://www.amazon.nl/*", "https://amazon.nl/*",
        "https://www.amazon.pl/*", "https://amazon.pl/*",
        "https://www.amazon.se/*", "https://amazon.se/*",
        "https://www.amazon.ca/*", "https://amazon.ca/*",
        "https://www.amazon.com.au/*", "https://amazon.com.au/*",
        "https://www.amazon.co.jp/*", "https://amazon.co.jp/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
